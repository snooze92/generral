<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Generral.Host</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Generral.Core\Generral.Core.csproj" />
    <ProjectReference Include="..\Generral.Http\Generral.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped presets: <app>/presets (docs/specs/05-mapping.md § Presets). -->
    <Content Include="..\..\presets\*.yaml" LinkBase="presets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
